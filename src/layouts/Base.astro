---
import Page from './Page.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

// Layout del blog: el esqueleto común más la cabecera y el pie del sitio.
export interface Props {
  title: string;
  description?: string;
  canonical: string;
}
const { title, description, canonical } = Astro.props;
---
<Page title={title} description={description} canonical={canonical} ogType="article">
  <SiteHeader current="blog" />
  <slot />
  <SiteFooter current="blog" />
</Page>

<!-- is:global porque el HTML de <Content /> (markdown) y los .cta de las
     paginas hijas no llevan el atributo de ambito de este componente, asi
     que un <style> normal no les aplicaria. Todo va bajo .wrap/.prose/.cta. -->
<style is:global>
  body {
    margin: 0; background: var(--bg-solid); color: var(--text-light);
    font-family: 'IBM Plex Mono', 'Courier New', monospace; min-height: 100vh;
  }
    .wrap { max-width: 760px; margin: 0 auto; padding: 0 20px; }
    .prose { font-size: 1.04rem; line-height: 1.8; }
    .prose h2, .prose h3 {
      font-family: 'Minecraftory', 'Press Start 2P', monospace;
      color: var(--yellow);
      line-height: 1.5;
      margin-top: 2em;
      letter-spacing: 1px;
    }
    .prose h2 { font-size: 1.35rem; }
    .prose h3 { font-size: 1.1rem; }
    .prose a { color: var(--blue-sky); font-weight: bold; }
    .prose img {
      max-width: 100%;
      height: auto;
      border: 3px solid var(--black);
      box-shadow: 7px 7px 0 var(--lime);
      border-radius: 8px;
      margin: 26px 0;
    }
    .prose code {
      background: #2a2b2c;
      padding: 2px 7px;
      border-radius: 5px;
      font-size: 0.94em;
      color: var(--lime);
    }
    .prose pre {
      background: #2a2b2c;
      padding: 18px;
      border-radius: 10px;
      overflow-x: auto;
      border: 2px solid var(--black);
    }
    .prose pre code { background: none; padding: 0; }
    .prose blockquote {
      border-left: 5px solid var(--lime);
      margin: 26px 0;
      padding: 4px 0 4px 20px;
      opacity: 0.92;
    }
    .prose table { width: 100%; border-collapse: collapse; margin: 24px 0; }
    .prose th, .prose td { border: 2px solid #4a4b4d; padding: 9px 12px; text-align: left; }
    .prose th { background: #2a2b2c; }
    .cta {
      display: block;
      text-align: center;
      background: var(--purple);
      color: var(--black);
      border: 4px solid var(--black);
      box-shadow: 9px 9px 0 var(--purple-dark);
      border-radius: 14px;
      padding: 26px 24px;
      margin: 54px 0 20px 0;
      text-decoration: none;
    }
    .cta b {
      display: block;
      font-family: 'Minecraftory', 'Press Start 2P', monospace;
      font-size: 1.1rem;
      margin-bottom: 10px;
      line-height: 1.5;
    }
    @media (max-width: 600px) {
      .prose h2 { font-size: 1.1rem; }
    }
  </style>
