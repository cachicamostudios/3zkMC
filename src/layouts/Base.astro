---
export interface Props {
  title: string;
  description?: string;
  canonical: string;
}
const { title, description = '', canonical } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="3zkMC" />
  <meta property="og:image" content="https://3zkmc.com/favicon.png" />
  <meta property="og:type" content="article" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  {description && <meta name="twitter:description" content={description} />}
  <meta name="twitter:image" content="https://3zkmc.com/favicon.png" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="alternate" type="application/rss+xml" title="3zkMC" href="/rss.xml" />
  <link href="https://fonts.googleapis.com/css?family=Press+Start+2P|IBM+Plex+Mono:700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/site.css" />
  <!-- is:global porque el HTML de <Content /> (markdown) y los .cta de las
       paginas hijas no llevan el data-attribute de ambito de este componente,
       asi que un <style> normal no les aplicaria. Todo va namespaced bajo
       .wrap / .prose / .cta para que no se escape a nada mas. -->
  <style is:global>
    .wrap { max-width: 760px; margin: 0 auto; padding: 0 20px; }
    .prose { font-size: 1.04rem; line-height: 1.8; }
    .prose h2, .prose h3 {
      font-family: 'Minecraftory', 'Press Start 2P', monospace;
      color: var(--yellow);
      line-height: 1.5;
      margin-top: 2em;
      letter-spacing: 1px;
    }
    .prose h2 { font-size: 1.35rem; }
    .prose h3 { font-size: 1.1rem; }
    .prose a { color: var(--blue-sky); font-weight: bold; }
    .prose img {
      max-width: 100%;
      height: auto;
      border: 3px solid var(--black);
      box-shadow: 7px 7px 0 var(--lime);
      border-radius: 8px;
      margin: 26px 0;
    }
    .prose code {
      background: #2a2b2c;
      padding: 2px 7px;
      border-radius: 5px;
      font-size: 0.94em;
      color: var(--lime);
    }
    .prose pre {
      background: #2a2b2c;
      padding: 18px;
      border-radius: 10px;
      overflow-x: auto;
      border: 2px solid var(--black);
    }
    .prose pre code { background: none; padding: 0; }
    .prose blockquote {
      border-left: 5px solid var(--lime);
      margin: 26px 0;
      padding: 4px 0 4px 20px;
      opacity: 0.92;
    }
    .prose table { width: 100%; border-collapse: collapse; margin: 24px 0; }
    .prose th, .prose td { border: 2px solid #4a4b4d; padding: 9px 12px; text-align: left; }
    .prose th { background: #2a2b2c; }
    .cta {
      display: block;
      text-align: center;
      background: var(--purple);
      color: var(--black);
      border: 4px solid var(--black);
      box-shadow: 9px 9px 0 var(--purple-dark);
      border-radius: 14px;
      padding: 26px 24px;
      margin: 54px 0 20px 0;
      text-decoration: none;
    }
    .cta b {
      display: block;
      font-family: 'Minecraftory', 'Press Start 2P', monospace;
      font-size: 1.1rem;
      margin-bottom: 10px;
      line-height: 1.5;
    }
    @media (max-width: 600px) {
      header { gap: 24px; padding: 18px 20px; }
      .prose h2 { font-size: 1.1rem; }
    }
  </style>
</head>
<body class="bg-solid">
  <header>
    <div class="logo-pixel">3zkMC</div>
    <nav>
      <a href="/index.html">Home</a>
      <a href="/blog/">Blog</a>
      <a href="/descargas.html">Schematics</a>
      <a href="/newsletter.html">Newsletter</a>
      <a href="https://www.youtube.com/@3zkmc" target="_blank" rel="noopener" class="nav-yt">YouTube</a>
      <a href="https://discord.gg/Hcuw2cqkdJ" target="_blank" rel="noopener" class="nav-dc">Discord</a>
    </nav>
  </header>

  <slot />

  <footer>
    <div class="footer-links">
      <a href="/index.html">Home</a> &bull;
      <a href="/blog/">Blog</a> &bull;
      <a href="/descargas.html">Schematics</a> &bull;
      <a href="/newsletter.html">Newsletter</a> &bull;
      <a href="/rss.xml">RSS</a>
    </div>
    <div><b>3zkMC</b> &copy; 2025 &bull; Crafted with GRIT &amp; Pixel Art</div>
  </footer>
</body>
</html>
