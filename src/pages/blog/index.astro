---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Blog — 3zkMC" description="Build guides, Create Mod machines and Project Sphere updates from 3zkMC." canonical="https://3zkmc.com/blog">
  <div class="wrap">
    <h1 style="font-family:'Minecraftory','Press Start 2P',monospace;font-size:2rem;line-height:1.5;letter-spacing:1px;margin:44px 0 8px 0;">Blog</h1>
    <p style="opacity:.85;line-height:1.7;margin:0 0 40px 0;">
      How the machines actually work &mdash; the write-up that goes with the video and the schematic.
    </p>

    {posts.length === 0 && <p style="opacity:.7;">Nothing published yet.</p>}

    <ul style="list-style:none;padding:0;margin:0;">
      {posts.map((post) => (
        <li style="margin-bottom:28px;padding-bottom:26px;border-bottom:2px solid #4a4b4d;">
          <a href={`/blog/${post.id}`} style="text-decoration:none;color:inherit;display:block;">
            <div style="font-family:'Minecraftory','Press Start 2P',monospace;font-size:1.2rem;line-height:1.5;color:var(--yellow);margin-bottom:8px;">
              {post.data.title}
            </div>
            <div style="opacity:.65;font-size:.88rem;margin-bottom:8px;">
              {post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
            </div>
            {post.data.description && <div style="line-height:1.7;opacity:.92;">{post.data.description}</div>}
          </a>
        </li>
      ))}
    </ul>

    <a class="cta" href="/newsletter">
      <b>Never miss a build &#9654;</b>
      <span>New posts and schematics, straight to your inbox. Free.</span>
    </a>
  </div>
</Base>
