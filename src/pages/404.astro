---
import Page from '../layouts/Page.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

// Sin un 404.html en la raíz del build, Cloudflare Pages trata el sitio como
// una SPA y responde a cualquier URL inexistente con la home y un 200: Google
// lo ve como contenido duplicado ("soft 404") y los enlaces rotos no se notan.
// Con este archivo, Pages devuelve esta página con un 404 de verdad.
---
<Page title="Page not found — 3zkMC" description="This page doesn't exist on 3zkMC." canonical="https://3zkmc.com/404">
  <meta slot="head" name="robots" content="noindex" />
  <SiteHeader />

  <main class="nf">
    <div class="code">404</div>
    <h1>This block isn't here</h1>
    <p>The page you're looking for was moved or never existed. Try one of these:</p>
    <div class="links">
      <a href="/">Home</a>
      <a href="/descargas">Schematics</a>
      <a href="/blog">Blog</a>
    </div>
  </main>

  <SiteFooter />
</Page>

<style is:global>
  body {
    margin: 0; background: var(--bg-solid); color: var(--text-light);
    font-family: 'IBM Plex Mono', 'Courier New', monospace;
  }
</style>

<style>
  .nf { max-width: 640px; margin: 70px auto 20px; padding: 0 20px; text-align: center; }
  .code {
    font-family: 'Minecraftory', 'Press Start 2P', monospace;
    font-size: 4.5rem; color: var(--lime); letter-spacing: 4px; line-height: 1;
    text-shadow: 6px 6px 0 var(--black);
  }
  h1 {
    font-family: 'Minecraftory', 'Press Start 2P', monospace;
    font-size: 1.5rem; line-height: 1.5; letter-spacing: 1px; margin: 26px 0 12px;
  }
  p { line-height: 1.7; opacity: 0.88; margin: 0 0 30px; }
  .links { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
  .links a {
    display: inline-block; background: var(--lime); color: var(--black);
    font-family: 'Minecraftory', 'Press Start 2P', monospace; font-size: 0.95rem;
    padding: 13px 24px; border: 3px solid var(--black); border-radius: 10px;
    box-shadow: 5px 5px 0 var(--yellow-dark); text-decoration: none; letter-spacing: 1px;
    transition: transform 0.13s, box-shadow 0.15s;
  }
  .links a:hover { transform: translate(-2px, -2px); box-shadow: 8px 8px 0 var(--yellow-dark); }
</style>
