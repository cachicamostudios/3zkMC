---
import Page from '../layouts/Page.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { sphereEpisode } from '../data/site';

// Las tarjetas de las dos columnas. Añadir o cambiar una es tocar esto,
// no el HTML de abajo. El episodio de Sphere sale de src/data/site.ts.
const createPosts = [
  {
    title: '⚙️ Create Mod Series',
    text: 'I have a series where I build and make videos with the Create Mod! I have everything from farms to videos explaining real life places, objects...',
    cta: 'Watch Series ▶',
    href: 'https://www.youtube.com/playlist?list=PLz73vlXJE6-iVQ7W5sxoj5GFIXf3Y-nhF',
  },
  {
    title: '🔧 Create Aeronautics',
    text: "Create Aeronautics is the BEST physics mod out there, and it pairs with the Create Mod! How amazing, it lets you do boats, planes, hot air balloons, ALL WITH PHYSICS!",
    // No hay lista de Aeronautics en el canal: se enlaza la búsqueda del canal,
    // que siempre muestra todos los vídeos del mod. Si creas la lista, cambia solo esta URL.
    cta: 'Watch Videos ▶',
    href: 'https://www.youtube.com/@3zkmc/search?query=aeronautics',
  },
];
const spherePosts = [
  {
    title: '🌐 The Vegas Sphere',
    text: 'Building the BEST PvP Arena in Minecraft — a massive sphere inspired by Las Vegas Sphere, inside a 120-mod survival world. Ep. 1-10: Foundation & terrain flattening.',
    cta: 'Watch Series ▶',
    href: 'https://www.youtube.com/@3zkmc/streams',
  },
  {
    title: '⚔️ Arena Progress',
    text: `${sphereEpisode}+ episodes of pure engineering: automating materials with Create Mod, sculpting the interior, and pushing Minecraft to its limits. Currently at Ep. ${sphereEpisode}!`,
    cta: 'Watch Now ▶',
    href: 'https://www.youtube.com/@3zkmc/streams',
  },
];
const externo = (href: string) => (href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {});
---
<Page
  title="3zkMC — Create Mod & Project Sphere"
  description="3zkMC: comunidad de Minecraft enfocada en el Create Mod y Project Sphere. Factories, schematics para descargar y builds épicas."
  canonical="https://3zkmc.com/"
>
  <SiteHeader current="home" />

  <div class="container">
    <section id="posts" class="posts-section">
      <div class="posts-columns">
        <div class="posts-col">
          <div class="posts-title col-title">🟨 Create Mod</div>
          <div class="posts-list-vertical">
            {createPosts.map((p) => (
              <div class="create-block">
                <h2>{p.title}</h2>
                <p>{p.text}</p>
                <a href={p.href} class="post-btn" {...externo(p.href)}>{p.cta}</a>
              </div>
            ))}
          </div>
        </div>
        <div class="posts-col">
          <div class="posts-title col-title">🟧 Project Sphere</div>
          <div class="posts-list-vertical">
            {spherePosts.map((p) => (
              <div class="pvp-block">
                <h2>{p.title}</h2>
                <p>{p.text}</p>
                <a href={p.href} class="post-btn pvp-btn" {...externo(p.href)}>{p.cta}</a>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="gallery" class="gallery-section">
      <div class="posts-columns">
        <div class="posts-col">
          <div class="gallery-title">🟨 Create Mod Gallery</div>
          <div class="gallery-cta"><a class="btn-factories" href="/factories">🔍 View all factories</a></div>
        </div>
        <div class="posts-col">
          <div class="gallery-title">🟧 Project Sphere Gallery</div>
          <div class="gallery-cta"><a class="btn-factories btn-sphere" href="/sphere">🌐 View Project Sphere</a></div>
        </div>
      </div>
    </section>

    <section class="feature-section">
      <div class="feature feature-blue">
        <h2>🌍 How to... in Minecraft</h2>
        <p class="feature-lead">My BEST series yet, where I explore different “events” from the real world and explain them using the Minecraft Create Mod, we've done things from Explaining Oil Extraction to the White House in Minecraft, and this series will go on, exploring different parts of our real world.</p>
        <a class="feature-btn" href="https://www.youtube.com/playlist?list=PLz73vlXJE6-jDZ6Ue7l47ixcs8g5TE977" target="_blank" rel="noopener">Watch the Series ▶</a>
      </div>
    </section>

    <div class="download-cta">
      <a class="btn-download" href="/descargas">⬇️ Schematics NBT / Download</a>
      <p>Find the <strong>.nbt</strong> blueprints for the machines shown in the gallery.</p>
    </div>

    <section id="about" class="about">
      <div class="posts-title">🧩 About 3zkMC</div>
      <div class="info-box about-box">
        <p>
          Welcome to <b>3zkMC</b> where Minecraft becomes a canvas for creativity, precision, and pure engineering magic.<br /><br />
          This channel is all about pushing the boundaries of Minecraft through <b>Create Mod</b> tutorials, smart automation, and immersive storytelling.
        </p>
        <p>
          ⚙️ <b>Want to learn how to build powerful machines, elegant contraptions, and efficient systems?</b><br />
          Here, you’ll learn how — step by step.
        </p>
        <p>
          🌄 <b>And soon, join us on a new journey inside ArdaCraft</b>, where we help build the world of Tolkien block by block. From dwarven halls to elven cities, you'll witness the art of construction at epic scale — and learn along the way.
        </p>
        <p>
          🎙️ Narrated by a young creator, powered by creativity, and built with purpose.
        </p>
        <p>
          <b>Subscribe, explore, and start learning how to build smarter, bigger, and with meaning.</b>
        </p>
      </div>
    </section>

    <section id="contact" class="contact">
      <div class="posts-title">📬 Contact</div>
      <div class="info-box contact-box">
        <p>
          Have questions, want to share your build, or collaborate?<br />
          <b>Email:</b> <a href="mailto:hello@3zkmc.com">hello@3zkmc.com</a><br />
          <b>YouTube:</b> <a href="https://www.youtube.com/@3zkmc" target="_blank" rel="noopener">3zkMC on YouTube</a><br />
          <b>Telegram:</b> <a href="https://t.me/+HGBS43P5G34xNGFk" target="_blank" rel="noopener">Join our channel</a><br />
          <b>Discord:</b> <a href="https://discord.gg/Hcuw2cqkdJ" target="_blank" rel="noopener">Join our server</a>
        </p>
      </div>
    </section>
  </div>

  <SiteFooter current="home" />
</Page>

<style is:global>
  html, body {
    margin: 0; padding: 0; font-family: 'IBM Plex Mono', 'Courier New', monospace;
    background-color: var(--bg-dark);
    background-image: conic-gradient(var(--bg-dark2) 25%, var(--bg-dark) 0 50%, var(--bg-dark2) 0 75%, var(--bg-dark) 0);
    background-size: 80px 80px;
    color: var(--text-light); min-height: 100vh; box-sizing: border-box;
  }
</style>

<style>
  .container { max-width: 1200px; margin: 34px auto 0; padding: 0 2vw; }

  .posts-section, .gallery-section { margin-bottom: 40px; }
  .posts-columns { display: grid; grid-template-columns: 1fr 1fr; gap: 34px; }
  .posts-col { display: flex; flex-direction: column; gap: 22px; }
  .posts-title {
    font-family: 'Minecraftory', 'Press Start 2P', monospace;
    font-size: 1.3rem; color: var(--text-light); margin-bottom: 14px; letter-spacing: 1px; text-align: left;
  }
  .col-title { text-align: center; font-size: 1.7rem; }
  .posts-list-vertical { display: flex; flex-direction: column; gap: 28px; }

  .create-block, .pvp-block {
    border: 5px solid var(--black); border-radius: 18px; padding: 28px 28px 24px;
    font-family: 'IBM Plex Mono', 'Courier New', monospace; position: relative;
    transition: box-shadow 0.15s, transform 0.15s; min-height: 160px; overflow: hidden;
  }
  .create-block { background: var(--yellow); box-shadow: 12px 12px 0 var(--yellow-dark); }
  .pvp-block { background: var(--pvp-main); box-shadow: 12px 12px 0 var(--pvp-dark); }
  .create-block h2, .pvp-block h2 {
    font-family: 'Minecraftory', 'Press Start 2P', monospace; font-size: 1.15rem; margin-top: 0;
  }
  .create-block h2 { color: var(--black); }
  .pvp-block h2 { color: #fff; }
  .create-block p { color: #232323; font-size: 1.05rem; }
  .pvp-block p { color: #fff; font-size: 1.05rem; }

  .post-btn {
    display: inline-block; background: var(--black); color: var(--yellow);
    border: 3px solid var(--black); padding: 10px 28px; text-decoration: none;
    font-weight: bold; letter-spacing: 1.2px; border-radius: 0;
    box-shadow: 3px 3px 0 var(--yellow-dark); transition: background 0.2s, color 0.2s;
    font-family: 'IBM Plex Mono', 'Courier New', monospace;
  }
  .post-btn:hover { background: var(--yellow-dark); color: var(--black); border-color: var(--shadow); }
  .pvp-btn { background: var(--black); color: var(--pvp-main); border: 3px solid #232323; box-shadow: 3px 3px 0 #232323; }
  .pvp-btn:hover { background: var(--pvp-dark); color: #fff; border-color: var(--black); }

  .gallery-title {
    font-family: 'Minecraftory', 'Press Start 2P', monospace;
    font-size: 1.2rem; color: var(--text-light); margin-bottom: 14px; text-align: center;
  }
  .gallery-cta { text-align: center; margin: 10px 0 24px; }
  .btn-factories {
    display: inline-block; background: #b8fc26; color: #232323;
    font-family: 'Minecraftory', 'Press Start 2P', monospace; font-size: 1.05rem; font-weight: bold;
    padding: 14px 26px; border: 3px solid #232323; border-radius: 12px; box-shadow: 6px 6px 0 #373737;
    text-decoration: none; letter-spacing: 1.1px; transition: 0.18s;
  }
  .btn-factories:hover { background: #c2a216; color: #fff; box-shadow: 10px 10px 0 #232323; }
  .btn-sphere { background: var(--pvp-main); color: #fff; border-color: var(--pvp-dark); box-shadow: 6px 6px 0 var(--pvp-dark); }

  .feature-section { margin: 40px 0; }
  .feature {
    border: 5px solid #232323; border-radius: 18px; padding: 34px 36px;
    text-align: center; color: #232323;
  }
  .feature-blue { background: #7ecaff; box-shadow: 12px 12px 0 #2c7fb8; }
  .feature h2 {
    font-family: 'Minecraftory', 'Press Start 2P', monospace;
    font-size: 1.55rem; margin: 0 0 18px; color: #232323;
  }
  .feature-lead { font-size: 1.12rem; line-height: 1.7; margin: 0 auto 26px; max-width: 840px; color: #232323; }
  .feature-btn {
    display: inline-block; background: #232323; color: #7ecaff;
    font-family: 'Minecraftory', 'Press Start 2P', monospace; font-size: 1.05rem;
    padding: 14px 32px; border: 3px solid #232323; box-shadow: 5px 5px 0 #2c7fb8;
    text-decoration: none; letter-spacing: 1px;
  }

  .download-cta { text-align: center; margin: 54px 0 40px; }
  .btn-download {
    display: inline-block; background: #b8fc26; color: #232323;
    font-family: 'Minecraftory', 'Press Start 2P', monospace; font-size: 1.17rem; font-weight: bold;
    padding: 18px 36px; border: 3.5px solid #232323; border-radius: 13px;
    box-shadow: 7px 7px 0 #373737; text-decoration: none; letter-spacing: 1.2px; transition: 0.2s;
  }
  .btn-download:hover { background: #c2a216; color: #fff; box-shadow: 13px 13px 0 #232323; }
  .download-cta p { margin-top: 12px; font-size: 0.95rem; }

  .about { margin: 54px 0 40px; }
  .contact { margin: 44px 0 20px; }
  .info-box {
    background: #fff; border: 3px solid #232323; border-radius: 10px;
    box-shadow: 4px 4px 0 #c2a216; color: #232323;
  }
  .about-box { padding: 24px; font-size: 1.1rem; }
  .contact-box { padding: 20px; }
  .contact-box a { color: #232323; }

  @media (max-width: 900px) {
    .posts-columns { grid-template-columns: 1fr; }
    .posts-col { margin-bottom: 38px; }
  }
  @media (max-width: 600px) {
    .container { padding: 0 3vw; }
  }
</style>
