---
import Page from '../layouts/Page.astro';
import SubHeader from '../components/SubHeader.astro';
import GalleryModal from '../components/GalleryModal.astro';
import SiteFooter from '../components/SiteFooter.astro';
import schematics from '../data/schematics.json';

// Las tarjetas salen de src/data/schematics.json. Añadir un schematic es
// añadir una entrada allí: nombre, slug de Gumroad y las imágenes, que viven
// en public/schematics/. El orden del archivo es el orden en la página.
const img = (file: string) => `/schematics/${encodeURI(file)}`;
const gumroad = (slug: string) => `https://3zkmcuser.gumroad.com/l/${slug}?wanted=true`;
---
<Page
  title="Descargas de Esquemáticos Minecraft - 3zkMC"
  description="Descarga schematics y esquemáticos de Minecraft gratuitos de 3zkMC. Builds del Create Mod listos para importar en tu servidor."
  canonical="https://3zkmc.com/descargas"
  lang="es"
>
  <SubHeader theme="lime" />

  <h1>Download Schematics <span class="ext">.nbt</span> for your farms in your world</h1>

  <div class="newsletter-cta">
    <div class="cta-text">
      <div class="cta-title">Every schematic here is free</div>
      <div class="cta-sub">The newsletter is where the new ones land first &mdash; plus build guides and Project Sphere updates.</div>
    </div>
    <a href="/newsletter">Subscribe &#9654;</a>
  </div>

  <div class="schematics-list">
    {schematics.map((s) => (
      <div class="schematic-card">
        <div class="mini-gallery">
          {s.images.map((file, i) => (
            <img src={img(file)} alt={`${s.name} - Vista ${i + 1}`} loading="lazy" decoding="async" />
          ))}
        </div>
        <h3>{s.name}</h3>
        <a class="gumroad-button" href={gumroad(s.gumroad)}>Get schematic — free</a>
      </div>
    ))}
  </div>

  <GalleryModal />
  <SiteFooter current="schematics" />

  <!-- Overlay de Gumroad: abre el checkout en un modal sin salir de la página. -->
  <script is:inline src="https://gumroad.com/js/gumroad.js"></script>
</Page>

<style is:global>
  body {
    margin: 0; background: #3a3b3d; color: #e8e8e8;
    font-family: 'IBM Plex Mono', 'Courier New', monospace;
  }
  /* Globales a propósito: gumroad.js reescribe el botón e inyecta HTML dentro,
     y ese HTML no lleva el atributo de ámbito de Astro, así que unas reglas
     con ámbito no lo alcanzarían. Todo va bajo .schematic-card. */
  .schematic-card a.gumroad-button {
    display: inline-block !important;
    background: #b8fc26 !important;
    color: #232323 !important;
    font-family: 'IBM Plex Mono', monospace !important;
    font-size: 1.04rem !important;
    font-weight: bold !important;
    padding: 11px 34px !important;
    border: 2.5px solid #232323 !important;
    border-radius: 8px !important;
    box-shadow: 3px 3px 0 #c2a216 !important;
    text-decoration: none !important;
    margin-top: 9px !important;
    letter-spacing: normal !important;
    text-transform: none !important;
    min-height: 0 !important;
    line-height: normal !important;
    transition: background 0.19s, color 0.19s, box-shadow 0.18s;
  }
  .schematic-card a.gumroad-button:hover {
    background: #c2a216 !important;
    color: #fff !important;
    box-shadow: 8px 8px 0 #373737 !important;
  }
  .schematic-card a.gumroad-button .logo-full { display: none !important; }
</style>

<style>
  h1 {
    font-family: 'Minecraftory', 'Press Start 2P', monospace;
    text-align: center; font-size: 1.22rem; color: #e8e8e8;
    margin: 28px 0 32px; letter-spacing: 1px;
  }
  .ext { color: #397ee7; }

  .newsletter-cta {
    max-width: 820px; margin: 0 auto 38px; padding: 22px 26px;
    background: #b98cf0; color: #232323;
    border: 4px solid #232323; border-radius: 14px; box-shadow: 9px 9px 0 #6b3fa0;
    display: flex; align-items: center; gap: 22px; flex-wrap: wrap;
    justify-content: center; text-align: center;
  }
  .cta-text { flex: 1 1 340px; min-width: 280px; }
  .cta-title {
    font-family: 'Minecraftory', 'Press Start 2P', monospace;
    font-size: 1.15rem; letter-spacing: 1px; margin-bottom: 8px; line-height: 1.5;
  }
  .cta-sub { font-size: 1rem; line-height: 1.6; font-weight: bold; }
  .newsletter-cta a {
    display: inline-block; background: #232323; color: #b98cf0;
    font-family: 'Minecraftory', 'Press Start 2P', monospace; font-size: 1rem;
    text-decoration: none; padding: 16px 26px; border: 3px solid #232323;
    border-radius: 10px; box-shadow: 5px 5px 0 #6b3fa0; letter-spacing: 1px; white-space: nowrap;
  }

  .schematics-list {
    display: flex; flex-wrap: wrap; gap: 34px; justify-content: center;
    margin: 30px auto 60px; max-width: 1240px;
  }
  .schematic-card {
    background: #fff; border: 3.5px solid #232323; box-shadow: 9px 9px 0 #b8fc26;
    border-radius: 16px; padding: 22px 18px 26px; text-align: center; width: 330px;
    transition: box-shadow 0.15s, transform 0.13s;
  }
  .schematic-card:hover { box-shadow: 13px 13px 0 #373737; transform: scale(1.035) rotate(-1deg); }
  .mini-gallery { display: flex; gap: 10px; overflow-x: auto; margin-bottom: 16px; justify-content: center; }
  .mini-gallery img {
    width: 96px; height: 96px; border-radius: 7px; object-fit: cover;
    border: 2px solid #b8fc26; background: #eee; box-shadow: 2px 2px 0 #c2a216;
  }
  .schematic-card h3 {
    font-family: 'Minecraftory', 'Press Start 2P', monospace;
    font-size: 1.13rem; color: #232323; margin: 4px 0 10px; letter-spacing: 1px;
  }
  @media (max-width: 700px) {
    .schematics-list { flex-direction: column; align-items: center; }
    /* border-box: si no, 98vw + padding + borde se sale de la pantalla */
    .schematic-card { width: 98vw; box-sizing: border-box; }
    .mini-gallery img { width: 28vw; height: 28vw; max-width: 110px; }
  }
</style>
