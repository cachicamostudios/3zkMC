---
// Cabecera de las páginas secundarias: logo + botón de vuelta sobre una barra
// de color. 'lime' para schematics y factories, 'pvp' para Project Sphere.
export interface Props { theme?: 'lime' | 'pvp'; }
const { theme = 'lime' } = Astro.props;
---
<header class:list={['subheader', theme]}>
  <div class="logo-pixel">3zkMC</div>
  <div class="back-wrap">
    <a class="back-home" href="/index.html">&larr; Back Home</a>
  </div>
</header>

<style>
  /* Todo explícito: assets/site.css tiene reglas globales sobre <header>
     (flex en fila, gap, fondo amarillo) pensadas para la home. Si esta
     cabecera heredara alguna, el logo y el botón se pondrían en fila. */
  .subheader {
    display: block;
    gap: 0;
    padding: 34px 0 16px;
    text-align: center;
    border-bottom: 6px solid #232323;
  }
  .logo-pixel {
    font-family: 'Minecraftory', 'Press Start 2P', monospace;
    font-size: 2.1rem;
    letter-spacing: 1px;
  }
  .back-wrap { margin-top: 12px; }
  .back-home {
    display: inline-block;
    margin-top: 12px;
    background: #232323;
    color: #fff;
    padding: 11px 30px;
    border-radius: 9px;
    border: 2.5px solid;
    text-decoration: none;
    font-weight: bold;
    font-family: 'IBM Plex Mono', monospace;
    transition: 0.17s;
  }

  .lime { background: #b8fc26; box-shadow: 0 7px 0 #373737; }
  .lime .logo-pixel { color: #232323; }
  .lime .back-home { border-color: #c2a216; box-shadow: 2px 2px 0 #b8fc26; }
  .lime .back-home:hover { background: #b8fc26; color: #232323; }

  .pvp { background: #ff6b35; box-shadow: 0 7px 0 #c43d00; }
  .pvp .logo-pixel { color: #fff; }
  .pvp .back-home { border-color: #ff6b35; box-shadow: 2px 2px 0 #c43d00; }
  .pvp .back-home:hover { background: #c43d00; color: #fff; }
</style>
